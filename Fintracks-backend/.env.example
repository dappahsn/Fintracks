PORT=4000
CORS_ORIGIN=http://localhost:5173

# MySQL Connection (gunakan DATABASE_URL atau variabel DB_* terpisah)
# DATABASE_URL=mysql://user:password@host:4000/fintracks
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fintracks
DB_USER=root
DB_PASSWORD=

# Aktifkan untuk MySQL Cloud yang mewajibkan SSL (mis. TiDB Cloud, Aiven)
DB_SSL=false
# DB_SSL_REJECT_UNAUTHORIZED=true

# JWT Secret (wajib diganti dengan string acak panjang di production)
JWT_SECRET=change-this-to-a-strong-secret-key
JWT_EXPIRES_IN=7d
